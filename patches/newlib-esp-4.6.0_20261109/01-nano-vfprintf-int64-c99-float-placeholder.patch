diff --git a/newlib/libc/stdio/nano-vfprintf_i.c b/newlib/libc/stdio/nano-vfprintf_i.c
index f7da952..06178cc 100644
--- a/newlib/libc/stdio/nano-vfprintf_i.c
+++ b/newlib/libc/stdio/nano-vfprintf_i.c
@@ -104,6 +104,46 @@ _printf_common (struct _reent *data,
 error:
   return -1;
 }
+
+#ifdef FLOATING_POINT
+int
+_printf_float_disabled (struct _reent *data,
+			struct _prt_data_t *pdata,
+			FILE *fp,
+			int (*pfunc)(struct _reent *, FILE *,
+				     const char *, size_t len),
+			va_list *ap)
+{
+  if (pdata->flags & LONGDBL)
+    (void) GET_ARG (N, (*ap), _LONG_DOUBLE);
+  else
+    (void) GET_ARG (N, (*ap), double);
+
+  PRINT ("<f>", 3);
+  return 3;
+error:
+  return -1;
+}
+#endif
+
+static u_quad_t
+_get_int_arg (int flags, va_list *ap, int is_signed)
+{
+  if (flags & QUADINT)
+    return GET_ARG (N, (*ap), u_quad_t);
+  if (flags & LONGINT)
+    return is_signed ? (u_quad_t)(quad_t)GET_ARG (N, (*ap), long)
+		     : (u_quad_t)GET_ARG (N, (*ap), u_long);
+  if (flags & SHORTINT)
+    return is_signed ? (u_quad_t)(quad_t)(short)GET_ARG (N, (*ap), int)
+		     : (u_quad_t)(u_short)GET_ARG (N, (*ap), int);
+  if (flags & CHARINT)
+    return is_signed ? (u_quad_t)(quad_t)(signed char)GET_ARG (N, (*ap), int)
+		     : (u_quad_t)(unsigned char)GET_ARG (N, (*ap), int);
+  return is_signed ? (u_quad_t)(quad_t)GET_ARG (N, (*ap), int)
+		   : (u_quad_t)GET_ARG (N, (*ap), u_int);
+}
+
