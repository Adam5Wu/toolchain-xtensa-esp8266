 	  pdata->l_buf[0] = '-';
 	}
       base = 10;
       goto number;
     case 'u':
     case 'o':
-      _uquad = UARG (pdata->flags);
+      _uquad = _get_int_arg (pdata->flags, ap, 0);
       base = (pdata->code == 'o') ? 8 : 10;
       goto nosign;
     case 'X':
@@ -158,7 +198,7 @@ _printf_i (struct _reent *data, struct _prt_data_t *pdata, FILE *fp,
       pdata->l_buf[2] = 'x';
       xdigs = "0123456789abcdef";
 hex:
-      _uquad = UARG (pdata->flags);
+      _uquad = _get_int_arg (pdata->flags, ap, 0);
       base = 16;
       if (pdata->flags & ALT)
 	pdata->flags |= HEXPREFIX;
@@ -193,18 +233,24 @@ number:
 	    }
